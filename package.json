{
  "name": "shipped-secrets",
  "version": "1.0.0",
  "description": "Find secrets that ship to the browser or sit in git history, and check whether they still work: your real .env values, known key shapes and risky public env names, in any framework's build output, source maps included.",
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.js" },
    "./vite": { "types": "./src/vite.d.ts", "default": "./src/vite.js" }
  },
  "types": "./src/index.d.ts",
  "bin": { "shipped-secrets": "bin/shipped-secrets.js" },
  "files": ["src", "bin"],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:apps": "node test/apps/run.mjs"
  },
  "keywords": ["secrets", "security", "vite", "nextjs", "env", "bundle", "leak", "supabase", "stripe", "ci", "git-history", "verify"],
  "author": "Fuad Laguda",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/lagudafuadtosin/shipped-secrets.git" },
  "engines": { "node": ">=18" }
}
